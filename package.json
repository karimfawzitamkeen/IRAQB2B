{
  "name": "tamkeen-coo-video",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Certificate of Origin Attestation — 25s motion graphics film (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render CertificateOfOrigin9x16 out/certificate-of-origin-9x16-screen.mp4 --image-format=png",
    "render:16x9": "remotion render CertificateOfOrigin out/certificate-of-origin.mp4",
    "typecheck": "tsc -p .",
    "render:sla": "remotion render SmartLegalAdvisor9x16 out/smart-legal-advisor-9x16.mp4 --image-format=png",
    "render:dooh": "remotion render TamkeenDOOH9x16 out/tamkeen-dooh-9x16.mp4 --image-format=png",
    "render:tp": "remotion render TradePoint9x16 out/tradepoint-9x16.mp4 --image-format=png",
    "render:ar": "remotion render CertificateOfOriginAR9x16 out/certificate-of-origin-ar-9x16.mp4 --image-format=png",
    "render:ar16": "remotion render CertificateOfOriginAR16x9 out/certificate-of-origin-ar-16x9.mp4 --image-format=png",
    "render:story": "remotion render CooStory16x9 out/coo-story-16x9.mp4 --image-format=png",
    "render:story-captions": "remotion render CooStory16x9Captions out/coo-story-16x9-captions.mp4 --image-format=png"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/cli": "4.0.290",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
